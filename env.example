# Copy this file to ".env" (same folder) and fill it in.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your chat ID (run: python crowdworks_bot.py --get-chat-id)
TELEGRAM_CHAT_ID=

# CrowdWorks search pages to watch, comma-separated.
# Leave empty to use the 5 built-in category pages (226, 311, 230, 235, 242, newest first).
SEARCH_URLS=

# Keywords live in keywords.txt (one per line). Optional extras, comma-separated.
# A job is alerted when its category (the "…Webデザインの仕事の依頼" part) contains
# any keyword, or the keyword appears in its title/description.
KEYWORDS=
# Never alert if any of these is the client's username, or appears in the
# title/description (comma-separated), e.g. EXCLUDE_KEYWORDS=spam_client1,spam_client2
EXCLUDE_KEYWORDS=

# Seconds between checks (minimum 60). 300 = 5 minutes.
CHECK_INTERVAL=300
# Seconds to wait between individual page requests to CrowdWorks (minimum 1)
REQUEST_DELAY=3
# true = open a new job's page to read its category/full description when the
# title alone doesn't match (more accurate, one extra request per new job)
FETCH_DETAILS=true

# true = also alert for jobs already listed the first time the bot runs
ALERT_ON_FIRST_RUN=false
